# ============================================================
# Ecommerce Agent 环境变量模板
# 复制为 .env 并填入真实值：cp .env.example .env
# ============================================================

# LLM Configuration（主 LLM，用于技能执行/反思/综合）
LLM_PROVIDER=DashScope
LLM_API_KEY=your-api-key-here
LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=your-model-name
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=8000

# Router LLM（意图路由专用，可指向更快更便宜的模型，留空则复用 LLM_*）
ROUTER_API_KEY=your-router-api-key
ROUTER_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
ROUTER_MODEL_NAME=your-router-model-name

# VLM（多模态视觉：图片解析，留空则复用 LLM_*）
VLM_API_KEY=your-vlm-api-key
VLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
VLM_MODEL_NAME=your-vlm-model-name

# Embedding Configuration（USE_LOCAL_EMBEDDING=true 时使用本地模型，无需 API）
USE_LOCAL_EMBEDDING=true
LOCAL_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_API_KEY=
EMBEDDING_API_BASE=
EMBEDDING_MODEL_NAME=text-embedding-v4

# Feishu API Configuration
FEISHU_APP_ID=your-feishu-app-id
FEISHU_APP_SECRET=your-feishu-app-secret
FEISHU_BOT_NAME=Ecommerce Agent
FEISHU_WEBHOOK_SECRET=your-verification-token
FEISHU_ENCRYPT_KEY=your-aes-encrypt-key

# Database Configuration
DATABASE_URL=sqlite:///./feishu_agent.db

# Application Configuration
LOG_LEVEL=INFO
APP_PORT=8000

# API 鉴权（HTTP 接口 X-API-Key；留空则关闭鉴权）
API_KEY=

# 高危操作审批门（降价/打折等指令触发飞书审批卡片，true/false）
APPROVAL_ENABLED=true
